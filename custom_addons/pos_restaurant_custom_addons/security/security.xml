<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pos_restaurant_custom" model="ir.module.category">
        <field name="name">Integrasi Pesanan Online &amp; Restoran</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_online_order_user" model="res.groups">
        <field name="name">Petugas / Kasir</field>
        <field name="category_id" ref="module_category_pos_restaurant_custom"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_online_order_manager" model="res.groups">
        <field name="name">Manager Restoran</field>
        <field name="category_id" ref="module_category_pos_restaurant_custom"/>
        <field name="implied_ids" eval="[(4, ref('group_online_order_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
