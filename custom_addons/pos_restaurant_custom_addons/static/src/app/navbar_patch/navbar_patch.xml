<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Tombol Pesanan Online & Menu Laporan Harian per Sesi di Navbar PoS -->
    <t t-name="pos_restaurant_custom_addons.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('status-buttons')]" position="inside">
            <!-- Tombol Menu Navbar: Laporan Harian per Sesi -->
            <div class="oe_status cursor-pointer d-flex align-items-center px-3 py-1 me-2 btn btn-outline-dark border rounded-pill my-auto"
                 t-on-click="onDailyReportClick"
                 title="Pilih &amp; Tampilkan Laporan Harian Berdasarkan Sesi POS"
                 style="height: 38px;">
                <i class="fa fa-calendar-check-o fs-5 me-2 text-dark"></i>
                <span class="d-none d-md-inline fw-semibold text-dark">Laporan Sesi</span>
            </div>

            <!-- Tombol Pesanan Online Delivery (Sheepo, Grob, Gejok) -->
            <OnlineOrdersButton />
        </xpath>

        <!-- Menu Kas Kecil & Laporan Harian di Burger Menu ≡ pada Tablet POS -->
        <xpath expr="//li[hasclass('ticket-button')]" position="after">
            <li class="menu-item navbar-button py-1" t-on-click="onDailyReportClick">
                <a class="dropdown-item py-2 d-flex align-items-center cursor-pointer">
                    <i class="fa fa-calendar-check-o text-dark me-2 fs-5"></i>
                    <span class="fw-bold text-dark">Laporan Harian per Sesi</span>
                </a>
            </li>
            <li class="menu-item navbar-button py-1" t-on-click="onPettyCashClick">
                <a class="dropdown-item py-2 d-flex align-items-center cursor-pointer">
                    <i class="fa fa-money text-success me-2 fs-5"></i>
                    <span class="fw-bold text-dark">Pengeluaran Kas Kecil</span>
                </a>
            </li>
        </xpath>
    </t>

</templates>