<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_custom_addons.PettyCashPopup">
        <div class="popup petty-cash-popup modal-dialog-scrollable" style="max-width: 680px; width: 92%; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 45px rgba(0,0,0,0.25);">
            <!-- Header Modal Modern & Bersih (Putih Bersih) -->
            <header class="modal-header d-flex justify-content-between align-items-center bg-white border-bottom px-4 py-3" style="background-color: #ffffff !important; border-bottom: 1px solid #e9ecef !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: rgba(25, 135, 84, 0.1) !important;">
                        <i class="fa fa-money text-success fs-4" style="color: #198754 !important;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark m-0" style="color: #1e293b !important; font-size: 1.2rem;">Form Pengeluaran Kas Kecil</h5>
                        <small class="text-muted" style="color: #64748b !important;">Pencatatan pengeluaran operasional toko oleh Kepala Toko</small>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center shadow-none close-btn" 
                        t-on-click="cancel" 
                        style="width: 32px; height: 32px; padding: 0; border: 1px solid #dee2e6; color: #64748b;"
                        title="Tutup">
                    <i class="fa fa-times" style="font-size: 14px;"></i>
                </button>
            </header>

            <main class="modal-body p-4 overflow-auto bg-white" style="max-height: 72vh;">
                <!-- Ringkasan Total Pengeluaran Hari Ini -->
                <div class="alert alert-info d-flex justify-content-between align-items-center py-2 px-3 mb-3 border-0 rounded-3 shadow-sm" style="background-color: #e0f2fe; color: #0369a1;">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-calculator me-2 fs-5 text-primary"></i>
                        <span class="fw-semibold">Total Kas Kecil Terpakai Shift Hari Ini:</span>
                    </div>
                    <strong class="fs-5 text-primary" t-esc="formatRupiah(store.totalToday)"/>
                </div>

                <!-- Pesan Validasi -->
                <div t-if="state.errorMessage" class="alert alert-danger py-2 px-3 mb-3 small d-flex align-items-center rounded-3">
                    <i class="fa fa-exclamation-triangle me-2 fs-5"></i>
                    <div>
                        <t t-esc="state.errorMessage"/>
                    </div>
                </div>

                <!-- Form Input Kas Kecil -->
                <div class="card border p-3 mb-3 bg-light rounded-3 shadow-sm" style="background-color: #f8fafc !important;">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="fa fa-pencil-square-o me-1 text-primary"></i> Input Data Pengeluaran Toko
                    </h6>

                    <!-- 1. Nominal Pengeluaran -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Nominal Pengeluaran (Rp) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white fw-bold">Rp</span>
                            <input type="number" 
                                   class="form-control form-control-lg fw-bold text-dark" 
                                   placeholder="Contoh: 45000"
                                   t-model="state.amount"/>
                        </div>
                    </div>

                    <!-- 2. Kategori Pengeluaran -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">
                            Kategori Keperluan <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-md" 
                                t-model="state.category" 
                                t-on-change="onCategoryChange"
                                t-att-class="{'is-invalid': state.categoryError}">
                            <option value="">-- Pilih Kategori Pengeluaran --</option>
                            <t t-foreach="categories" t-as="cat" t-key="cat.key">
                                <option t-att-value="cat.key" t-esc="cat.label"/>
                            </t>
                        </select>
                        <div t-if="state.categoryError" class="invalid-feedback d-block fw-semibold mt-1">
                            <i class="fa fa-exclamation-circle me-1"></i><t t-esc="state.categoryError"/>
                        </div>
                        <small class="text-muted d-block mt-1" style="font-size: 11px;">
                            Pilih kategori yang sesuai dengan peruntukan belanja operasional.
                        </small>
                    </div>

                    <!-- 3. Catatan Keperluan -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Catatan / Detail Keperluan <span class="text-danger">*</span></label>
                        <textarea class="form-control" 
                                  rows="2" 
                                  placeholder="Contoh: Beli 2 tabung gas LPG 3kg karena stok dapur habis saat jam makan siang..."
                                  t-model="state.notes"></textarea>
                    </div>

                    <!-- 4. Upload Foto Bukti Nota / Struk -->
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">
                            <i class="fa fa-camera me-1"></i> Foto Bukti Struk / Nota Fisik
                        </label>
                        <input type="file" 
                               class="form-control" 
                               accept="image/*" 
                               capture="environment"
                               t-on-change="onFileChange"/>

                        <!-- Preview Gambar -->
                        <div t-if="state.imagePreview" class="mt-2 position-relative d-inline-block border p-1 rounded bg-white shadow-sm">
                            <img t-att-src="state.imagePreview" 
                                 alt="Bukti Struk" 
                                 style="max-height: 120px; max-width: 180px; object-fit: contain;"/>
                            <button type="button" 
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-0 rounded-circle d-flex align-items-center justify-content-center"
                                    style="width: 22px; height: 22px;"
                                    title="Hapus Foto"
                                    t-on-click="removeImage">
                                <i class="fa fa-times" style="font-size: 10px;"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Riwayat Kas Kecil Shift Hari Ini -->
                <div class="border rounded-3 p-3 bg-white shadow-sm">
                    <h6 class="fw-bold text-muted mb-2 small text-uppercase">
                        <i class="fa fa-history me-1"></i> Riwayat Pengeluaran Hari Ini (<t t-esc="store.records.length"/> Catatan)
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover m-0 align-middle" style="font-size: 13px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Waktu</th>
                                    <th>Kategori</th>
                                    <th>Catatan</th>
                                    <th>Pencatat</th>
                                    <th>Bukti</th>
                                    <th class="text-end">Nominal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="store.records" t-as="rec" t-key="rec.id">
                                    <tr>
                                        <td class="text-muted" t-esc="rec.time"/>
                                        <td>
                                            <span class="badge bg-light text-dark border" t-esc="rec.category"/>
                                        </td>
                                        <td t-esc="rec.notes"/>
                                        <td class="small fw-semibold text-secondary" t-esc="rec.cashier"/>
                                        <td>
                                            <span t-if="rec.has_receipt" class="badge bg-success">
                                                <i class="fa fa-check"></i> Foto Ada
                                            </span>
                                            <span t-else="" class="text-muted">-</span>
                                        </td>
                                        <td class="text-end fw-bold text-danger" t-esc="'- ' + formatRupiah(rec.amount)"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <!-- Footer Modal -->
            <footer class="modal-footer bg-light border-top px-4 py-2 d-flex justify-content-between">
                <button class="btn btn-secondary px-4" t-on-click="cancel">
                    <t t-esc="props.closePopup"/>
                </button>
                <button class="btn btn-success px-4 fw-bold shadow-sm" 
                        t-att-disabled="state.isSubmitting"
                        t-on-click="saveExpense">
                    <i class="fa fa-check-circle me-1"></i> Simpan Pengeluaran
                </button>
            </footer>
        </div>
    </t>

</templates>