        <field name="name">Portal Manajemen Restoran</field>
        <field name="tag">restaurant_management_dashboard</field>
        <field name="target">current</field>
        <field name="context">{'default_tab': 'reconciliation'}</field>
    </record>

    <record id="action_restaurant_reconciliation" model="ir.actions.client">
        <field name="name">Rekonsiliasi Harian</field>
