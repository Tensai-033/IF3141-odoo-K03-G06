        <field name="target">current</field>
        <field name="context">{'default_tab': 'sales_reports'}</field>
    </record>

    <record id="action_restaurant_configuration" model="ir.actions.client">
        <field name="name">Konfigurasi &amp; Hak Akses</field>
        <field name="tag">restaurant_configuration_dashboard</field>
