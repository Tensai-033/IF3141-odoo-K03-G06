<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_restaurant_petty_cash_tree" model="ir.ui.view">
        <field name="name">restaurant.petty.cash.tree</field>
        <field name="model">restaurant.petty.cash</field>
        <field name="arch" type="xml">
            <tree string="Daftar Pengeluaran Kas Kecil (Petty Cash)">
                <field name="date"/>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="notes"/>
                <field name="amount" sum="Total Pengeluaran"/>
                <field name="cashier_id"/>
            </tree>
        </field>
    </record>

    <record id="view_restaurant_petty_cash_form" model="ir.ui.view">
        <field name="name">restaurant.petty.cash.form</field>
        <field name="model">restaurant.petty.cash</field>
        <field name="arch" type="xml">
            <form string="Catatan Kas Kecil">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="No. Bukti"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Pengeluaran">
                            <field name="amount"/>
                            <field name="category"/>
                            <field name="date"/>
                            <field name="cashier_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                        </group>
                        <group string="Bukti Struk / Nota Fisik">
                            <field name="receipt_image" widget="image" class="oe_avatar" options="{'preview_image': 'receipt_image', 'size': [200, 200]}"/>
                            <field name="receipt_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Catatan / Rincian Keperluan">
                        <field name="notes" placeholder="Tuliskan alasan pembelian dan rincian barang yang dibeli..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_restaurant_petty_cash" model="ir.actions.act_window">
        <field name="name">Petty Cash</field>
        <field name="res_model">restaurant.petty.cash</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada catatan pengeluaran kas kecil hari ini.
            </p>
        </field>
    </record>

</odoo>
